{
    "name": "shop/orders",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-grpc": "*",
        "google/protobuf": "^4.31",
        "spiral/cycle-bridge": "^2.13",
        "spiral/framework": "^3.18",
        "spiral/nyholm-bridge": "^1.3",
        "spiral/roadrunner-bridge": "^3.8",
        "spiral/validator": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src",
            "GRPC\\": "generated/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {
            "spiral/composer-publish-plugin": true
        }
    },
    "minimum-stability": "stable"
}
